{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  // Shared compiler options for the workspace. Each package has its own
  // tsconfig.json with its own include/exclude and, where needed, DOM libs.
  "include": ["vitest.config.ts", "bump.config.ts"],
  "exclude": []
}
