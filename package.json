{
  "name": "glowglow",
  "type": "module",
  "version": "0.1.3",
  "description": "CSS-first, language-agnostic syntax highlighting for the web. A maintained TypeScript fork of nue-glow.",
  "license": "MIT",
  "homepage": "https://github.com/hhk-png/glowglow",
  "repository": {
    "type": "git",
    "url": "git@github.com:hhk-png/glowglow.git"
  },
  "bugs": {
    "url": "https://github.com/hhk-png/glowglow/issues"
  },
  "keywords": [
    "syntax-highlighting",
    "syntax-highlighter",
    "highlight",
    "code",
    "markdown",
    "css",
    "nue",
    "glow"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "css",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "fix": "eslint . --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "release": "bumpp --push",
    "prepublishOnly": "pnpm build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint . --fix --cache"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
