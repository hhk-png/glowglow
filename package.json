{
  "name": "glowglow-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/hhk-png/glowglow",
  "repository": {
    "type": "git",
    "url": "git@github.com:hhk-png/glowglow.git"
  },
  "bugs": {
    "url": "https://github.com/hhk-png/glowglow/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter glowglow run build && pnpm --filter @glowglow/react --filter @glowglow/vue run build",
    "build:core": "pnpm --filter glowglow run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm build:core && pnpm --filter glowglow run typecheck && pnpm --filter @glowglow/react --filter @glowglow/vue run typecheck",
    "lint": "eslint . --cache",
    "fix": "eslint . --fix",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:browser": "pnpm --filter glowglow run test:browser",
    "bench": "pnpm --filter glowglow run bench",
    "preview:generate": "pnpm --filter glowglow run preview:generate",
    "release": "bumpp --push",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix --cache"
  }
}
