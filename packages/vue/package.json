{
  "name": "@glowglow/vue",
  "type": "module",
  "version": "0.3.1",
  "description": "Vue components for glowglow syntax highlighting and live editing",
  "license": "MIT",
  "homepage": "https://github.com/hhk-png/glowglow",
  "repository": {
    "type": "git",
    "url": "git@github.com:hhk-png/glowglow.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/hhk-png/glowglow/issues"
  },
  "keywords": [
    "syntax-highlighting",
    "syntax-highlighter",
    "vue",
    "editor",
    "glowglow"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "dependencies": {
    "@glowglow/core": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
